{
  "version": 2,
  "env": {
    "DISCORD_BOT_TOKEN": "[set-in-vercel-dashboard]",
    "GOOGLE_SCRIPT_URL": "https://script.google.com/macros/s/AKfycbwjUoUvKfL5WrCiPBI6dWRnb7zeNxL1rDz8tMMxI3nGOgKHHyHQYvczGUQbdT_34-JdoQ/exec"
  },
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.jpg", "use": "@vercel/static" },
    { "src": "*.pdf", "use": "@vercel/static" },
    { "src": "*.png", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/submit", "dest": "/api/submit.js" },
    { "src": "/flyer", "dest": "/flyer.html" },
    { "src": "/flyer.html", "dest": "/flyer.html" },
    { "src": "/dancer.jpg", "dest": "/dancer.jpg" },
    { "src": "/FeaturedEntertainer-Flyer.pdf", "dest": "/FeaturedEntertainer-Flyer.pdf" },
    { "src": "/FeaturedEntertainer-Flyer.png", "dest": "/FeaturedEntertainer-Flyer.png" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
